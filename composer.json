{
    "name": "fom/module-conditional-plugins",
    "description": "Run Magento plugins and observers only on the editions and versions declared with PHP attributes",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "Friends of Magento",
            "homepage": "https://github.com/FriendsOfMagento"
        }
    ],
    "homepage": "https://github.com/FriendsOfMagento/module-conditional-plugins",
    "support": {
        "issues": "https://github.com/FriendsOfMagento/module-conditional-plugins/issues",
        "source": "https://github.com/FriendsOfMagento/module-conditional-plugins"
    },
    "require": {
        "php": ">=8.1",
        "magento/framework": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Fom\\ConditionalPlugins\\": ""
        }
    },
    "config": {
        "sort-packages": true
    }
}
